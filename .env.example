# Copy this file to .env and fill in real values. Never commit .env itself.

# --- LLM Provider Selection ---
# Choose one: openai | groq | gemini
# Only the selected provider's API key below needs to be set.
LLM_PROVIDER=groq

# --- Provider API Keys ---
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
.
# --- OpenAI-specific (only used when LLM_PROVIDER=openai) ---
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Shared generation settings (apply to whichever provider is selected) ---
# Leave LLM_MODEL blank to use that provider's own default model.
LLM_MODEL=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=800
LLM_TIMEOUT_SECONDS=30

# --- Sentiment Analysis ---
SENTIMENT_MODEL_NAME=cardiffnlp/twitter-roberta-base-sentiment-latest
SENTIMENT_USE_TRANSFORMER=true
SENTIMENT_CONFIDENCE_FLOOR=0.4
SENTIMENT_ESCALATION_THRESHOLD=0.75

# --- App ---
APP_TITLE=Advanced GenAI Customer Service Bot
LOG_LEVEL=INFO
ENVIRONMENT=development
