# Copy this file to .env and fill in real values. Never commit .env itself.

# --- LLM (OpenAI-compatible) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=800
LLM_TIMEOUT_SECONDS=30

# --- Sentiment Analysis ---
SENTIMENT_MODEL_NAME=cardiffnlp/twitter-roberta-base-sentiment-latest
SENTIMENT_USE_TRANSFORMER=true
SENTIMENT_CONFIDENCE_FLOOR=0.4
SENTIMENT_ESCALATION_THRESHOLD=0.75

# --- App ---
APP_TITLE=Advanced GenAI Customer Service Bot
LOG_LEVEL=INFO
ENVIRONMENT=development
